        await http?.GetFromJsonAsync<PlayerDto>("https://localhost:7275/api/players/current");
    } *@
    protected override async Task OnInitializedAsync()
    {
        player = await httpClient.GetFromJsonAsync<PlayerDto>("https://localhost:7275/api/players/current");
