@page "/profile"
@using System.Security.Claims
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@inject PersistentComponentState ApplicationState
@inject IPlayerAppService PlayerService
@attribute [Authorize]
@implements IDisposable


@if (_player != null)
{
  <div class="flex pt-8 flex-col items-center justify-center gap-16">
    <div class="flex flex-col items-center gap-5">
    <h1 class="text-lg font-bold">Update Profile</h1>
      <EditForm class="flex flex-col items-center justify-center gap-6" Model=@_player OnValidSubmit=@FormSubmitted>
        <div class="flex flex-col items-center gap-1">
          <label class="font-bold">Name</label>
          <InputText class="w-[200px] text-center px-4 py-2 rounded-lg" @bind-Value="_player.Name" />
        </div>
        <div class="flex flex-col items-center gap-1">
          <label class="font-bold">Nickname</label>
          <InputText class="w-[200px] text-center px-4 py-2 rounded-lg" @bind-Value="_player.Nickname" />
        </div>
        <div class="flex flex-col items-center gap-1">
          <label class="font-bold">Emoji</label>
          <DataAnnotationsValidator /> <!-- Enables validation based on the data annotations -->
          <ValidationSummary class="text-red-400 py-2" />
          <InputText class="w-[200px] text-center px-4 py-2 rounded-lg" @bind-Value="_player.Emoji" />
        </div>
        <input type="submit" value="Submit" class="px-8 py-4 bg-primary-200 rounded-lg text-white mt-4" />
      </EditForm>
    </div>
    <a class="bg-red-400 px-8 py-4 rounded-lg text-white" href="Account/Logout">Log out</a>
  </div>
}

@code
{
  [CascadingParameter]
  private Task<AuthenticationState>? authenticationState { get; set; }

  private PlayerDto? _player;

  private PersistingComponentStateSubscription _subscription;

  protected override async Task OnInitializedAsync()
  {
    if (authenticationState is null)
    {
      Console.WriteLine("WOPWO");
    }
    _subscription = ApplicationState.RegisterOnPersisting(Persist);
    var foundInState = ApplicationState
    .TryTakeFromJson<PlayerDto>("player", out var player);

    if (foundInState)
    {
      _player = player;
      return;
    }
    else if (authenticationState != null)
    {
      var state = await authenticationState;
      Console.WriteLine("HEEI");
      Console.WriteLine(state.User.GetUserId());
      var user = state.User;
      @* PlayerAppService.GetById(state.User.GetUserId()); *@
      var id = state.User.GetUserId();

      _player = await PlayerService.GetById(id);
    }
  }
  private Task Persist()
  {
    ApplicationState.PersistAsJson("player", _player);
    return Task.CompletedTask;
  }

  public void Dispose()
  {
    _subscription.Dispose();
  }

  async Task FormSubmitted()
  {
    if (_player is not null)
    {
      await PlayerService.Update(_player);
    }
    // Post data to the server, etc
  }
}
