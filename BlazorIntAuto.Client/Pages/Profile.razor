@page "/profile"
@using System.Security.Claims
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@inject PersistentComponentState ApplicationState
@inject IPlayerAppService PlayerService
@attribute [Authorize]
@implements IDisposable


@if (_player != null)
{
  <div class="flex flex-col items-center justify-center gap-4">
    <EditForm class="flex flex-col items-center justify-center gap-4" Model=@_player OnValidSubmit=@FormSubmitted>
      <label>Name</label>
      <InputText class="bg-slate-400 w-[200px]" @bind-Value="_player.Name" />
      <label>Nickname</label>
      <InputText class="bg-slate-400 w-[200px]" @bind-Value="_player.Nickname" />
      <label>Emoji</label>
      <div class="flex flex-col items-center gap-1">
        <DataAnnotationsValidator/>  <!-- Enables validation based on the data annotations -->
        <ValidationSummary class="text-red-600 bg-blue-400 mb-0"/>
        <InputText class="bg-slate-400 w-[200px]" @bind-Value="_player.Emoji" />
      </div>
      <input type="submit" value="Submit" class="btn btn-primary" />
    </EditForm>

    <a class="bg-red-500 px-8 py-4 text-white" href="Account/Logout">Log out</a>
  </div>
  <div>@_player.Emoji</div>
  <button @onclick="onclick">click me</button>
}

@code
{
  [CascadingParameter]
  private Task<AuthenticationState>? authenticationState { get; set; }

  public void onclick()
  {
    Console.WriteLine("clicked");

  }

  string Status = "Not submitted";
  Person Person = new Person();

  private PlayerDto? _player;

  private PersistingComponentStateSubscription _subscription;


  protected override async Task OnInitializedAsync()
  {
    if (authenticationState is null)
    {
      Console.WriteLine("WOPWO");
    }
    _subscription = ApplicationState.RegisterOnPersisting(Persist);
    var foundInState = ApplicationState
    .TryTakeFromJson<PlayerDto>("player", out var player);
    
    if (foundInState)
    {
      _player = player;
      return;
    }
    else if (authenticationState != null)
    {
      var state = await authenticationState;
      Console.WriteLine("HEEI");
      Console.WriteLine(state.User.GetUserId());
      @* PlayerAppService.GetPlayerById(state.User.GetUserId()); *@
      var id = state.User.GetUserId();

      _player = await PlayerService.GetPlayerById(id);
    }
  }
  private Task Persist()
  {
    ApplicationState.PersistAsJson("player", _player);
    return Task.CompletedTask;
  }

  public void Dispose()
  {
    _subscription.Dispose();
  }

  async Task FormSubmitted()
  {
    Status = "Form submitted";
    if(_player is not null)
    {
      await PlayerService.UpdatePlayer(_player);
    }
    // Post data to the server, etc
  }
}
