@page "/leaderboard"
@using System.Security.Claims
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@inject PersistentComponentState ApplicationState
@inject IPlayerAppService PlayerService
@attribute [Authorize]

<h3>Leaderboard</h3>
<button class="btn btn-primary" @onclick="IncrementCount">Click me</button> <!-- Weather goes here -->
@if(_qrcode is not null)
{
    <div class="flex items-center justify-center">
        <div class="max-w-36">
            <img class="" src="data:image/jpeg;base64,@_qrcode.QrCode"/>
        </div>
    </div>
    
}
<div>hei</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? authenticationState { get; set; }

    private int _currentCount = 0;
    private QrCodeDto _qrcode;

    private async void IncrementCount()
    {
        _currentCount++;
        Console.WriteLine(_qrcode.QrCode);
    }

    protected override async Task OnInitializedAsync()
    {
        if (authenticationState is not null)
        {
            var state = await authenticationState;
            var id = state.User.GetUserId();
            var qrcode = await PlayerService.GetQrCode(id);

            _qrcode = qrcode;
        }
    }

}
