@page "/leaderboard"
@rendermode InteractiveAuto
@attribute [Authorize]

<h3>Leaderboard</h3>
<button class="btn btn-primary" @onclick="IncrementCount">Click me</button>

@code {
      private int _currentCount = 0;
          private void IncrementCount()
    {
        _currentCount++;
        Console.WriteLine("Incremented count");
    }

}
