@page "/qr-scanner"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@layout MainFullLayout
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>QrScanner</PageTitle>
@if (_isLoading) {
    <div>Loading...</div>
}

<div  id="reader" />

@code {
    private int _currentCount = 0;
    private bool _isLoading = false;

    private void IncrementCount()
    {
        _currentCount++;
        Console.WriteLine("Incremented count");
    }

    [JSInvokable]
    public static void ReceiveDecodedText(string decodedText)
    {
        Console.WriteLine($"Received decoded text: {decodedText}");
        // Handle the decoded text as needed
    }

     private async Task CallJavaScriptFunction()
    {
        await JS.InvokeVoidAsync("startQrCodeScanner");
    }
        private bool _hasRun = false;
    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        // Call the cleanup function when navigating away
        JS.InvokeVoidAsync("stopQrCodeScanner").GetAwaiter();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_hasRun)
        {
            Console.WriteLine("First render");
            _isLoading = true;
            _hasRun = true;
            await JS.InvokeVoidAsync("setupQrCodeScanner");
            @* await JS.InvokeVoidAsync("startQrCodeScanner"); *@
            _isLoading = false;
        }
    } 
}
